# Ollama Cloud API
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=""
OLLAMA_TEMPERATURE=0.7

# Per-route model assignments (must be available on Ollama cloud)
OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
OLLAMA_MODEL_INTENT=minimax-m3

# Server
SERVER_PORT=8080

# Langfuse
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
OPENAI_API_KEY=""
